# Keep checkout disabled until identity, the durable webhook projection,
# protected release delivery and the production acceptance gates all pass.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_WEBHOOK_ENABLED=false
GUMMYUI_ORIGIN=https://gummyui.dev
# The URL is public routing information; the server secret must exist in both
# the Convex deployment and the Vercel server environment.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_SERVER_SECRET=
DOWNLOAD_GRANT_SECRET=
DOWNLOAD_GRANT_TTL_SECONDS=300
# HMACs account, workspace and trusted Vercel IP bindings before the
# distributed limiter stores them. Use a separate random value of 32+ chars.
RATE_LIMIT_KEY_SECRET=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_WEBHOOK_ENABLED=false
WORKOS_WEBHOOK_SECRET=
# WorkOS's server SDK reads WORKOS_REDIRECT_URI. The public copy contains no
# credential and must remain exactly equal for proxy and browser routing.
WORKOS_REDIRECT_URI=https://gummyui.dev/auth/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://gummyui.dev/auth/callback
# Production should set STRIPE_RESTRICTED_KEY to a least-privilege
# rk_test_/rk_live_ key. STRIPE_SECRET_KEY remains a compatibility fallback for
# local and integration-managed environments.
STRIPE_RESTRICTED_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_YEARLY=
STRIPE_PRICE_INDIVIDUAL_LIFETIME=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_TEAM_LIFETIME=
STRIPE_PRICE_ORGANIZATION_MONTHLY=
STRIPE_PRICE_ORGANIZATION_YEARLY=
STRIPE_PRICE_ORGANIZATION_LIFETIME=

# Private Backblaze B2 S3-compatible release storage.
BACKBLAZE_B2_ENDPOINT=
BACKBLAZE_B2_REGION=
BACKBLAZE_B2_BUCKET=
BACKBLAZE_B2_KEY_ID=
BACKBLAZE_B2_APPLICATION_KEY=

# Immutable encrypted operational backups use a separate least-privilege B2
# bucket and two separately controlled cryptographic keys.
BACKUP_B2_ENDPOINT=
BACKUP_B2_REGION=
BACKUP_B2_BUCKET=
BACKUP_B2_KEY_ID=
BACKUP_B2_APPLICATION_KEY=
BACKUP_B2_PREFIX=production
BACKUP_RETENTION_DAYS=35
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_ENCRYPTION_KEY_BASE64=
BACKUP_AUTHENTICATION_KEY_ID=
BACKUP_AUTHENTICATION_KEY_BASE64=

# Operator-only restore proof. Keep disabled in normal app environments.
# The target must be a new empty Convex development deployment. Its deployment
# separately requires BACKUP_RESTORE_ENABLED=true, BACKUP_RESTORE_TARGET_CLASS
# set to isolated-test, BACKUP_RESTORE_SECRET and CONVEX_SERVER_SECRET.
BACKUP_RESTORE_PROOF_ENABLED=false
BACKUP_RESTORE_TARGET_CONVEX_URL=
BACKUP_RESTORE_TARGET_SERVER_SECRET=
BACKUP_RESTORE_SECRET=
BACKUP_RESTORE_TARGET_CLASS=
BACKUP_RESTORE_TARGET_CONFIRMATION=

# Transactional product email. Stripe owns receipts/dunning and WorkOS owns
# authentication mail; Resend sends only Gummy UI access and status notices.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gummy UI <updates@send.kreydlabs.com>
RESEND_REPLY_TO_EMAIL=support@kreydlabs.com
RESEND_WEBHOOK_ENABLED=false
RESEND_WEBHOOK_SECRET=
SUPPORT_EMAIL=support@kreydlabs.com
CRON_SECRET=
ACCOUNT_DELETION_PEPPER=

# Optional outside production. Required by the production readiness health
# gate so alerts receive the same redacted structured events as Vercel logs.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_HOST=in.logs.betterstack.com
# Optional, separate Better Stack secret success URLs for scheduled jobs.
# Each must use https://uptime.betterstack.com/api/v1/heartbeat/<token>.
BETTER_STACK_HEARTBEAT_EMAIL_OUTBOX_URL=
BETTER_STACK_HEARTBEAT_PRIVACY_JOBS_URL=
BETTER_STACK_HEARTBEAT_BACKUP_URL=
BETTER_STACK_HEARTBEAT_BACKUP_VERIFY_URL=
HEALTH_DEPENDENCY_CHECKS_ENABLED=false
