{
  "name": "gummyui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-brace-expansion-compat.mjs",
    "predev": "npm run registry:build",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run registry:build",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run docs:api:check && npm run pro:metadata:check && npm run localisation:check && npm run test:localisation && npm run test:unit && npm run test:boundary && npm run test:fixtures && npm run registry:verify && npm run test:rendered",
    "test:unit": "vitest run",
    "test:localisation": "node --test tests/LocalisationSource.node.mjs",
    "test:boundary": "node --test tests/registry-boundary.test.mjs",
    "test:fixtures": "node --test tests/clean-consumers.test.mjs",
    "test:a11y": "vitest run tests/ComponentCatalogue.a11y.test.tsx tests/GummyButton.a11y.test.tsx tests/Stage1B.a11y.test.tsx tests/Stage1BGroup2.a11y.test.tsx tests/Stage3FormControls.a11y.test.tsx tests/Stage3LayoutFeedback.a11y.test.tsx tests/Stage3DisplayFeedback.a11y.test.tsx tests/Stage3NavigationDisclosure.a11y.test.tsx tests/Stage3SelectionControls.a11y.test.tsx tests/Stage3Overlays.a11y.test.tsx tests/Stage3NavigationSystems.a11y.test.tsx tests/Stage3CompositeInputs.a11y.test.tsx tests/Stage3DataUtilities.a11y.test.tsx",
    "test:browser:production": "npm run build && node scripts/verify-browser-production.mjs",
    "test:rendered": "npm run build && npm run security:artifact && npm run performance:budget && node --test tests/rendered-html.test.mjs",
    "docs:api": "node scripts/generate-component-api.mjs",
    "docs:api:check": "node scripts/generate-component-api.mjs --check",
    "pro:metadata:sync": "node scripts/sync-pro-metadata.mjs",
    "pro:metadata:check": "node scripts/sync-pro-metadata.mjs --check",
    "localisation:build": "node scripts/localisation-build.mjs",
    "localisation:check": "node scripts/localisation-build.mjs --check && node scripts/localisation-validate.mjs",
    "localisation:validate": "node scripts/localisation-validate.mjs",
    "styles:build": "node scripts/extract-core-component-styles.mjs && npm run styles:routes",
    "styles:routes": "node scripts/build-route-styles.mjs",
    "styles:routes:check": "node scripts/build-route-styles.mjs --check",
    "registry:build": "npm run docs:api && npm run styles:build && node scripts/build-registry.mjs",
    "registry:verify": "npm run registry:build && npm run registry:verify:integrity && npm run registry:verify:consumers",
    "registry:verify:integrity": "node scripts/verify-registry.mjs",
    "registry:verify:consumers": "node scripts/verify-clean-consumers.mjs --frameworks next,vite --package-managers npm",
    "registry:verify:matrix": "npm run registry:build && node scripts/verify-clean-consumers.mjs --frameworks next,vite --package-managers npm,pnpm,yarn,bun",
    "security:artifact": "node scripts/verify-artifact-boundary.mjs",
    "performance:budget": "node scripts/verify-performance-budgets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260726.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "axe-core": "^4.12.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
