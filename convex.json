{
  "functions": "convex/",
  "authKit": {
    "dev": {
      "configure": {
        "redirectUris": [
          "http://localhost:3000/auth/callback"
        ],
        "appHomepageUrl": "http://localhost:3000",
        "corsOrigins": [
          "http://localhost:3000"
        ]
      },
      "localEnvVars": {
        "WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
        "WORKOS_API_KEY": "${authEnv.WORKOS_API_KEY}",
        "GUMMYUI_ORIGIN": "http://localhost:3000",
        "WORKOS_REDIRECT_URI": "http://localhost:3000/auth/callback",
        "NEXT_PUBLIC_WORKOS_REDIRECT_URI": "http://localhost:3000/auth/callback"
      }
    },
    "prod": {
      "environmentType": "production",
      "configure": {
        "redirectUris": [
          "https://gummyui.dev/auth/callback"
        ],
        "appHomepageUrl": "https://gummyui.dev",
        "corsOrigins": [
          "https://gummyui.dev",
          "https://www.gummyui.dev"
        ]
      }
    }
  }
}
