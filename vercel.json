{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "crons": [
    {
      "path": "/api/cron/email-outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/privacy-jobs",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/backup-verify",
      "schedule": "45 3 * * 0"
    },
    {
      "path": "/api/cron/stripe-readiness",
      "schedule": "15 4 1 * *"
    }
  ]
}
